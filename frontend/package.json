{
  "name": "peakrdl-html-single-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bun run check && bun test && bunx --bun vite build --config vite.shell.config.ts && bun scripts/package-shell.ts",
    "build:kit": "bunx --bun vite build",
    "check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --write . 1>/dev/null && eslint .",
    "prepare": "cd .. && husky frontend/.husky",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "latest",
    "@fontsource-variable/inter": "latest",
    "@tanstack/svelte-hotkeys": "^0.10.0",
    "clsx": "latest",
    "effect": "latest",
    "flexsearch": "latest",
    "markdown-it": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/markdown-it": "latest",
    "@types/node": "^26.1.2",
    "bits-ui": "^2.16.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "latest",
    "vite-plugin-singlefile": "latest"
  }
}
